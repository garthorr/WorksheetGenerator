# --- Access -----------------------------------------------------------------
# Password for the web GUI. Set it even on a tailnet: any web page you visit can
# send requests to tailnet hosts through your browser. AI generation uses your
# Ollama instance. Leave empty to disable login.
APP_PASSWORD=
# Host names the app answers to, comma-separated (localhost is always allowed for
# the healthcheck). Empty: the Traefik deploy uses WORKSHEETS_HOST; the local
# compose answers to any name, which leaves DNS-rebinding pages a way in.
ALLOWED_HOSTS=
# Optional: secret used to sign login cookies. If empty, a random one is made on
# first run and kept in the data volume. Changing it (or the password) logs
# everyone out. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Traefik ----------------------------------------------------------------
# Served by the home Traefik; DNS points at its Tailscale IP, like the other
# *.home.tastymath.com apps.
WORKSHEETS_HOST=worksheet.home.tastymath.com
# Name of the ACME cert resolver in your Traefik config ("le" works on the
# home Traefik, as for ganttist).
TRAEFIK_CERTRESOLVER=le
# Client addresses Traefik lets through (default: Tailscale's ranges only).
# WORKSHEETS_ALLOW=100.64.0.0/10,fd7a:115c:a1e0::/48

# --- Ollama -----------------------------------------------------------------
# Initial values only; afterwards change them on the Setup page.
# From inside Docker, "localhost" is the container — use host.docker.internal
# (mapped in docker-compose.yml). On Linux, Ollama must listen beyond loopback
# (OLLAMA_HOST=0.0.0.0, or 172.17.0.1 for the Docker bridge only). It has no
# password, so firewall port 11434 from everything but Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must be pulled first, e.g.: ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b
