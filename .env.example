# --- Access -----------------------------------------------------------------
# Password for the web GUI. Strongly recommended: the site is public and
# AI generation uses your Ollama instance. Leave empty to disable login.
APP_PASSWORD=
# Optional: secret used to sign login cookies (any long random string).
# Changing it logs everyone out. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Traefik ----------------------------------------------------------------
WORKSHEETS_HOST=worksheets.tastymath.com
# Name of the ACME cert resolver in your Traefik config
# (your other stacks use "le" or "letsencrypt" — match the host this runs on).
TRAEFIK_CERTRESOLVER=le

# --- Ollama -----------------------------------------------------------------
# Initial values only; afterwards change them on the Setup page.
# From inside Docker, "localhost" is the container — use host.docker.internal
# (mapped in docker-compose.yml) and start Ollama with OLLAMA_HOST=0.0.0.0.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must be pulled first, e.g.: ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b
